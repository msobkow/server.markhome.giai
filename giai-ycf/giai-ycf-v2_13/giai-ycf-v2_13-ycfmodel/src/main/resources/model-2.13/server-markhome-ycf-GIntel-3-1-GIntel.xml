		Name="GIntel"
		Revision="3.1"
		Description="Yorkton Code Fractal GIntel - Guided Intelligence (Gi)"
		ProjectRoot="server.markhome.ycf.GIntel.3.1" >
	<Tld Name="server" >
		<TopDomain Name="markhome" >
			<TopProject Name="ycf" >
				<SubProject Name="GIntel" >
					<MajorVersion Name="3" >
						<MinorVersion Name="1" >
<SchemaDef Name="GIntel"
		DbName="GIntel31"
		ShortName="Gi"
		Description="Yorkton Code Fractal Guided Intelligence (Gi)"
		CopyrightHolder="Mark Stephen Sobkow"
		CopyrightPeriod="2026"
		AuthorEMail="mark.sobkow@gmail.com"
		ProjectURL="https://msobkow.github.io/"
		PublishURI="https://msobkow.github.io/index.html#gintel31"
		CommonLicenseName="Dual GPLv3/Commercial" CommonLicenseCode="DualGPLv3" >
