	<GenFile GenDef="SchemaDef" Name="fileConfigureAC"
		GenerateOnce="false"
		ModuleName=""
		SourceBundle="cplus"
		BasePackageName="lib$reference ManufacturingSchema lower PackageName$saxloader"
		SubPackageName=""
		ExpansionClassName="$SchemaName$ConfigureAC"
		ExpansionKeyName="configure.ac"
		ExpansionFileName="configure.ac"
>AC_INIT([$reference MinorVersion reference ParentMajVer reference ParentSPrj reference ParentTPrj Name$ $Name$ SAX Loader],$DotVersion$.$GeneratingBuild$,[$AuthorEMail$],[lib$lower SchemaName$saxloader],[$ProjectURL$])
