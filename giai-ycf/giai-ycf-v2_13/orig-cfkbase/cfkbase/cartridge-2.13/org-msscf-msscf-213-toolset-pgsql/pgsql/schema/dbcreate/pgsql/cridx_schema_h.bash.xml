<RuleSet
	xmlns="http://msscf.org:8088/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="http://msscf.org:8088/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd http://msscf.org:8088/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="pgsql"
	Name="schema/dbcreate/pgsql/cridx_schema.bash"
	Revision="2.13"
	Descr="null">

	<GenFile GenDef="SchemaDef" Name="dbadminfile_CreateAllHIndexes"
			GenerateOnce="false"
		ModuleName="$lower SchemaName$"
		SourceBundle="dbcreate"
		BasePackageName="$lower SchemaName$-$VUnderVersion$/jdbcsp"
		SubPackageName="pgsql"
		ExpansionClassName="cridx_$lower SchemaName$_h"
		ExpansionKeyName="cridx_$lower SchemaName$_h"
		ExpansionFileName="$dbadminfilename_CreateAllHIndexes$">#!/bin/bash
#
#	@(#) $GenPackageDir$/$GenFileName$
$MssBashScriptLicense$
$parsePgSqlArgs$$validatePgSqlArgs$
$iterate SchemaTables( each maybe_CreateTableHIndexes )$
</GenFile>

	<GenRule GenDef="Table" Name="maybe_CreateTableHIndexes">$switch BaseHasHistory yes invoke_CreateTableHIndexes default empty$</GenRule>

	<GenRule GenDef="Table" Name="invoke_CreateTableHIndexes"
		>$switch HasSuperClassRelation yes invoke_CreateTableHInhIndexes default invoke_CreateTableHBaseIndexes$</GenRule>

	<GenRule GenDef="Table" Name="invoke_CreateTableHInhIndexes"
		>$reference SuperClassRelation reference ToTable invoke_CreateTableHIndexes$$invoke_CreateTableHBaseIndexes$</GenRule>

	<GenRule GenDef="Table" Name="invoke_CreateTableHBaseIndexes"
		>$iterate Index( each maybe_CreateHIndex empty empty )$</GenRule>

	<GenRule GenDef="Index" Name="maybe_CreateHIndex"
		>$switch IsPrimaryIndex no invoke_CreateHIndex default empty$</GenRule>

	<GenRule GenDef="Index" Name="invoke_CreateHIndex"
		>psql -h $${pghost} $${PGPORT} -d $${pgdb} -U $${pguser} -a -e -f $dbadminfilename_CreateHIndex$ &gt;&gt;$${logfilename} 2&gt;&amp;1
</GenRule>

</RuleSet>
