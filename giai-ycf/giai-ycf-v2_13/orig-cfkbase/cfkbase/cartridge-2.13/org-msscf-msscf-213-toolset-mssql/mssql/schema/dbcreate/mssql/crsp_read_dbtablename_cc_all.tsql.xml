	ToolSet="mssql"
	Name="schema/dbcreate/mssql/crsp_read_dbtablename_cc_all.tsql"
	Revision="2.13"
	Descr="null">

	<GenFile ScopeDef="SchemaDef" GenDef="Table" Name="dbadminfile_CreateSPReadDbTableNameCCAll"
			GenerateOnce="false"
		ModuleName="$lower SchemaName$"
		SourceBundle="dbcreate"
		BasePackageName="$lower SchemaName$-$VUnderVersion$/jdbcsp"
		SubPackageName="mssql"
		ExpansionClassName="$dbadminfilename_CreateSPReadDbTableNameCCAll$"
		ExpansionKeyName="$dbadminfilename_CreateSPReadDbTableNameCCAll$"
		ExpansionFileName="$dbadminfilename_CreateSPReadDbTableNameCCAll$">--
--	@(#) $GenPackageDir$/$GenFileName$
$MssDoubleDashScriptLicense$
use $lower DbSchemaName$
go

create proc $sp_read_dbtablename_cc_all$$implMSSqlSPStandardArgs$
as$switch SecScope None empty System empty Cluster implMSSqlSPTableReallyDeclPermFlag Tenant implMSSqlSPTableReallyDeclPermFlag default error$
begin$poptop Table switch TableName Cluster empty Tenant empty SecUser empty default implMSSqlSPReadEnforceSec$
	select distinct( $lower reference BaseClass ClassCode$.classcode ) as classcode
	from $lower DbSchemaName$..$DbTableName$ as $lower ClassCode$$switch HasSuperClassRelation yes implMSSqlClassCodeJoinSuperTable default empty$
	order by classcode asc
end
go

quit
</GenFile>

</RuleSet>
