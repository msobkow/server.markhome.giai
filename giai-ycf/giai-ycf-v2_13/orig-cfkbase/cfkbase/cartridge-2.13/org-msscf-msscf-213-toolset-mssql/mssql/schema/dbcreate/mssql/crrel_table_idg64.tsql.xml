<RuleSet
	xmlns="http://msscf.org:8088/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="http://msscf.org:8088/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd http://msscf.org:8088/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="mssql"
	Name="schema/dbcreate/mssql/crrel_table_idg64.tsql"
	Revision="2.13"
	Descr="Microsoft SQL Server Developer Edition Create Id64Gen Table Relations T-SQL Script">

	<GenFile ScopeDef="Table" GenDef="Id64Gen" Name="dbadminfile_CreateTableIdg64Relations"
			GenerateOnce="false"
		ModuleName="$lower SchemaName$"
		SourceBundle="dbcreate"
		BasePackageName="$lower SchemaName$-$VUnderVersion$/jdbcsp"
		SubPackageName="mssql"
		ExpansionClassName="crrel_$lower DbTableName$_idg64"
		ExpansionKeyName="crrel_$lower DbTableName$_idg64"
		ExpansionFileName="$dbadminfilename_CreateTableIdg64Relations$">--
--	@(#) $GenPackageDir$/$GenFileName$
$MssDoubleDashScriptLicense$
use $lower DbSchemaName$
go

ALTER TABLE $lower DbSchemaName$..$DbTableName$_idg64 ADD CONSTRAINT $DbTableName$_idg64_prnt
	FOREIGN KEY ($reference Dispenser reference PrimaryKeyIndex iterate Columns( each clause_PKeyColComma last clause_PKeyCol )$
	) REFERENCES $lower DbSchemaName$..$reference Dispenser DbTableName$ ($reference Dispenser reference PrimaryKeyIndex iterate Columns( each clause_PKeyColComma last clause_PKeyCol )$ )$RunSqlStmt$
quit</GenFile>

</RuleSet>
