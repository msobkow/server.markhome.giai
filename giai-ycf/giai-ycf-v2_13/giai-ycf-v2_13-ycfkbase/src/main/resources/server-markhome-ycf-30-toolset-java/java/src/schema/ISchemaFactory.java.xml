<RuleSet
	xmlns="http://ycf.markhome.server/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="http://ycf.markhome.server/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd http://ycf.markhome.server/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="java"
	Name="src/schema/ISchemaFactory.java"
	Revision="3.0"
	Descr="Java 25 interface for a $SchemaName$ data object factory.">

	<GenFile GenDef="SchemaDef" Name="fileSchemaISchemaFactoryJava"
		GenerateOnce="false"
		ModuleName="$reference ManufacturingSchema lower JavaPackage$"
		SourceBundle="java"
		BasePackageName="$TopProjectDomainName$/$TopProjectMfgVersion$/$reference ManufacturingSchema SchemaProjectName$-core/src/main/java"
		SubPackageName="$reference ManufacturingSchema lower JavaPackage$.$reference ManufacturingSchema lower SchemaName$"
		ExpansionClassName="I$SchemaName$FactoryJava"
		ExpansionKeyName="I$SchemaName$FactoryJava"
		ExpansionFileName="I$SchemaName$Factory.java"
>// Description: Java 25 interface for a $SchemaName$ data object factory.

$MssSourceLicense$

package $reference ManufacturingSchema lower JavaPackage$.$reference ManufacturingSchema lower SchemaName$;

public interface I$SchemaName$Factory
{$iterate SchemaTables( each maybeDeclSchemaTableFactoryAccessors )$
}
</GenFile>

	<GenRule GenDef="Table" Name="maybeDeclSchemaTableFactoryAccessors">$switch HasDefSchema yes empty default reallyDeclSchemaTableFactoryAccessors$</GenRule>
	<GenRule GenDef="Table" Name="reallyDeclSchemaTableFactoryAccessors">
	/**
	 *	Get the $TableName$ Factory interface for the schema.
	 *
	 *	@return	The $TableName$ Factory interface for the schema.
	 */
	public I$DefSchemaName$$TableName$Factory getFactory$TableName$();
</GenRule>

</RuleSet>
