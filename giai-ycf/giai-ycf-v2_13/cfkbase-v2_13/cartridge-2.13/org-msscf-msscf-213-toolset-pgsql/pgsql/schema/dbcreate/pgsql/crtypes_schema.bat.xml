<RuleSet
	xmlns="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="pgsql"
	Name="schema/dbcreate/pgsql/crtypes_schema.bat"
	Revision="2.13"
	Descr="null">

	<GenFile GenDef="SchemaDef" Name="dbadminfile_CreateAllTypesBat"
			GenerateOnce="false"
		ModuleName="$lower SchemaName$"
		SourceBundle="dbcreate"
		BasePackageName="$lower SchemaName$-$VUnderVersion$/jdbcsp"
		SubPackageName="pgsql"
		ExpansionClassName="crtypes_$lower SchemaName$_bat"
		ExpansionKeyName="crtypes_$lower SchemaName$_bat"
		ExpansionFileName="$dbadminfilename_CreateAllTypesBat$">@ECHO off
REM
REM	@(#) $GenPackageDir$/$GenFileName$
$MssBatScriptLicense$
$parsePgSqlArgsBat$$validatePgSqlArgsBat$
$invoke_CreateTypeDbSchemaNameCCRecBat$$iterate SchemaTables( each invoke_CreateTableTypesBat empty empty )$
</GenFile>

	<GenRule GenDef="SchemaDef" Name="invoke_CreateTypeDbSchemaNameCCRecBat"
		>psql -h %pghost% -d %pgdb% -U %pguser% -a -e -f $dbadminfilename_CreateTypeDbSchemaNameCCRec$ &gt;&gt;%logfilename% 2&gt;&amp;1
</GenRule>

	<GenRule GenDef="Table" Name="invoke_CreateTableTypesBat"
		>$invoke_CreateTypeDbTableNameRecBat$
</GenRule>

	<GenRule GenDef="Table" Name="invoke_CreateTypeDbTableNameRecBat"
		>psql -h %pghost% -d %pgdb% -U %pguser% -a -e -f $dbadminfilename_CreateDbTableNameRecType$ &gt;&gt;%logfilename% 2&gt;&amp;1
</GenRule>

</RuleSet>
