<RuleSet
	xmlns="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="pgsql"
	Name="schema/dbcreate/pgsql/cridx_schema.bat"
	Revision="2.13"
	Descr="null">

	<GenFile GenDef="SchemaDef" Name="dbadminfile_CreateAllHIndexesBat"
			GenerateOnce="false"
		ModuleName="$lower SchemaName$"
		SourceBundle="dbcreate"
		BasePackageName="$lower SchemaName$-$VUnderVersion$/jdbcsp"
		SubPackageName="pgsql"
		ExpansionClassName="cridx_$lower SchemaName$_h_bat"
		ExpansionKeyName="cridx_$lower SchemaName$_h_bat"
		ExpansionFileName="$dbadminfilename_CreateAllHIndexesBat$">@ECHO off
REM
REM	@(#) $GenPackageDir$/$GenFileName$
$MssBatScriptLicense$
$parsePgSqlArgsBat$$validatePgSqlArgsBat$
$iterate SchemaTables( each maybe_CreateTableHIndexesBat )$
</GenFile>

	<GenRule GenDef="Table" Name="maybe_CreateTableHIndexesBat">$switch BaseHasHistory yes invoke_CreateTableHIndexesBat default empty$</GenRule>

	<GenRule GenDef="Table" Name="invoke_CreateTableHIndexesBat"
		>$switch HasSuperClassRelation yes invoke_CreateTableHInhIndexesBat default invoke_CreateTableHBaseIndexesBat$</GenRule>

	<GenRule GenDef="Table" Name="invoke_CreateTableHInhIndexesBat"
		>$reference SuperClassRelation reference ToTable invoke_CreateTableHIndexesBat$$invoke_CreateTableHBaseIndexesBat$</GenRule>

	<GenRule GenDef="Table" Name="invoke_CreateTableHBaseIndexesBat"
		>$iterate Index( each maybe_CreateHIndexBat empty empty )$</GenRule>

	<GenRule GenDef="Index" Name="maybe_CreateHIndexBat"
		>$switch IsPrimaryIndex no invoke_CreateHIndexBat default empty$</GenRule>

	<GenRule GenDef="Index" Name="invoke_CreateHIndexBat"
		>psql -h %pghost% -d %pgdb% -U %pguser% -a -e -f $dbadminfilename_CreateHIndex$ &gt;&gt;%logfilename% 2&gt;&amp;1
</GenRule>

</RuleSet>
