<RuleSet
	xmlns="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="java+jee"
	Name="WebContent/WEB-INF/lib/.gitignore"
	Revision="2.13"
	Descr="Java 11 Sec Manager WebContent/WEB-INF/lib/.gitignore">

	<GenFile GenDef="SchemaDef" Name="fileSchemaSMWarWebInfLibGitIgnore"
			GenerateOnce="false"
		ModuleName="$reference ManufacturingSchema lower JavaPackage$.$reference ManufacturingSchema lower SchemaName$smwar"
		SourceBundle="java"
		BasePackageName="$reference ManufacturingSchema lower JavaPackage$.$reference ManufacturingSchema lower SchemaName$smwar/WebContent"
		SubPackageName="WEB-INF/lib"
		ExpansionClassName="DotGitIgnoreWebInfLib"
		ExpansionKeyName="$SchemaName$DotGitIgnoreWebInfLib"
		ExpansionFileName=".gitignore"
>*.jar
</GenFile>

</RuleSet>
