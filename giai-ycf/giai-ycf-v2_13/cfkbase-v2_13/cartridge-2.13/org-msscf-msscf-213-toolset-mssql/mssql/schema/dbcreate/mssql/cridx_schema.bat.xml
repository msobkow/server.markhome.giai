<RuleSet
	xmlns="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="mssql"
	Name="schema/dbcreate/mssql/cridx_schema.bat"
	Revision="2.13"
	Descr="Microsoft SQL Server Developer Edition Create Schema Indexes Bash Script">

	<GenFile GenDef="SchemaDef" Name="dbadminfile_CreateAllIndexes"
			GenerateOnce="false"
		ModuleName="$lower SchemaName$"
		SourceBundle="dbcreate"
		BasePackageName="$lower SchemaName$-$VUnderVersion$/jdbcsp"
		SubPackageName="mssql"
		ExpansionClassName="cridx_$lower SchemaName$"
		ExpansionKeyName="cridx_$lower SchemaName$"
		ExpansionFileName="$dbadminfilename_CreateAllIndexes$"
>@ECHO OFF
REM	@(#) $GenPackageDir$/$GenFileName$
$MssBatScriptLicense$
$parseMSSqlArgs$$validateMSSqlArgs$$defineMSSqlCommands$
$iterate SchemaTables( each invoke_CreateTableIndexes empty empty )$
</GenFile>

	<GenRule ScopeDef="SchemaDef" GenDef="Table" Name="invoke_CreateTableIndexes">$iterate Index( each maybe_CreateIndex empty empty )$</GenRule>

	<GenRule ScopeDef="Table" GenDef="Index" Name="maybe_CreateIndex">$switch IsPrimaryIndex no invoke_CreateMappedIndex default empty$</GenRule>

	<GenRule ScopeDef="Table" GenDef="Index" Name="invoke_CreateMappedIndex">$switch IsDbMapped yes invoke_CreateIndex default empty$</GenRule>

	<GenRule ScopeDef="Table" GenDef="Index" Name="invoke_CreateIndex">%cmddb% &lt;$dbadminfilename_CreateIndex$ &gt;&gt;%logfilename%
</GenRule>

</RuleSet>
