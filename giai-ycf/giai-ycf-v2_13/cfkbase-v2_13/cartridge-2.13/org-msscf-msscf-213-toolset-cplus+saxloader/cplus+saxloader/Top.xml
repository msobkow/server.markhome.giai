<RuleSet
	xmlns="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="cplus+saxloader"
	Name="Top"
	Revision="2.13"
	Descr="Top level rules for building files">

	<GenRule GenDef="MinorVersion" Name="top"
		>$iterate SchemaDef( each schemaFiles )$</GenRule>

	<GenRule GenDef="Relation" Name="ToTableHasClassCode"
		>$reference ToTable HasClassCode$</GenRule>

	<GenRule GenDef="Relation" Name="ToTableHasLookupIndex"
		>$reference ToTable HasLookupIndex$</GenRule>

	<GenRule GenDef="RelationCol" Name="ToTableHasClassCode"
		>$reference RelationDef reference ToTable HasClassCode$</GenRule>

	<GenRule GenDef="RelationCol" Name="ToTableHasLookupIndex"
		>$reference RelationDef reference ToTable HasLookupIndex$</GenRule>

	<GenRule ScopeDef="MinorVersion" GenDef="SchemaDef" Name="schemaFiles"
		>$fileSchemaSaxLoaderGitIgnore$$fileLibSchemaSaxLoaderDotGitIgnore$$fileCleanSchemaSaxLoaderWslBash$$fileBuildSchemaSaxLoaderWslBash$$fileCompileSchemaSaxLoaderWslBash$$fileInstallSchemaSaxLoaderWslBash$$fileConfigureAC$$fileMakefileAM$$fileSchemaStructuredXsd$$fileSchemaSaxLdrHPlus$$fileSchemaSaxLdrCPlus$$iterate SchemaTables( each tableFiles )$$fileSchemaSaxLoaderHPlus$$fileSchemaSaxLoaderCPlus$$fileSchemaSaxLoaderPublicHPlus$$fileSchemaSaxLoaderPublicCPlus$</GenRule>

	<GenRule ScopeDef="SchemaDef" GenDef="Table" Name="tableFiles"
		>$fileSchemaSaxLoaderTableHandlerHPlus$$fileSchemaSaxLoaderTableHandlerCPlus$$tableXmlElementNameHandlers$</GenRule>

	<GenRule GenDef="Table" Name="tableXmlElementNameHandlers"
		>$switch HasSuperClassRelation yes tableXmlElementNameSuperHandlers default tableXmlElementNameBaseHandlers$</GenRule>

	<GenRule GenDef="Table" Name="tableXmlElementNameSuperHandlers"
		>$reference SuperClassRelation reference ToTable tableXmlElementNameHandlers$$iterate Columns( each tableXmlElementNameMaybeEmitColumn empty empty )$</GenRule>

	<GenRule GenDef="Table" Name="tableXmlElementNameBaseHandlers"
		>$iterate Columns( each tableXmlElementNameMaybeEmitColumn empty empty )$</GenRule>

	<GenRule GenDef="Value" Name="tableXmlElementNameMaybeEmitColumn"
		>$switch BaseModelAtomClass TextDef tableXmlElementNameMaybeEmitTextColumn default empty$</GenRule>

	<GenRule GenDef="Value" Name="tableXmlElementNameMaybeEmitTextColumn"
		>$switch HasXmlElementName no empty default tableXmlElementNameIfNotEmpty$</GenRule>

	<GenRule GenDef="Value" Name="tableXmlElementNameIfNotEmpty"
		>$switch XmlElementName empty empty default tableXmlElementNameHppAndCpp$</GenRule>

	<GenRule GenDef="Value" Name="tableXmlElementNameHppAndCpp"
		>$fileSchemaSaxLoaderTableAttrHandlerHPlus$$fileSchemaSaxLoaderTableAttrHandlerCPlus$</GenRule>

	<GenRule GenDef="Relation" Name="ContainerStyle">$popto Table ContainerStyle$</GenRule>
	<GenRule GenDef="Table" Name="ContainerStyle"
		>$switch ContainerStyleInternal
			Single ContainerStyleSingle
			None ContainerStyleNone
			empty ContainerStyleMultiple
			default ContainerStyleMultiple$</GenRule>

	<GenRule GenDef="Table" Name="ContainerStyleInternal"
		>$iterate ContainerRelations( lone ContainerStyleSingle empty ContainerStyleNone each ContainerStyleYada )$</GenRule>

	<GenRule GenDef="Object" Name="ContainerStyleYada">Yada</GenRule>
	<GenRule GenDef="Object" Name="ContainerStyleSingle">Single</GenRule>
	<GenRule GenDef="Object" Name="ContainerStyleNone">None</GenRule>
	<GenRule GenDef="Object" Name="ContainerStyleMultiple">Multiple</GenRule>

</RuleSet>
