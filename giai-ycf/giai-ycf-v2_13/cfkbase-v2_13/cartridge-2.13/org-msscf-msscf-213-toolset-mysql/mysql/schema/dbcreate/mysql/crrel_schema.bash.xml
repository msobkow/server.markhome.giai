<RuleSet
	xmlns="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="mysql"
	Name="schema/dbcreate/mysql/crrel_schema.bash"
	Revision="2.13"
	Descr="null">

	<GenFile GenDef="SchemaDef" Name="dbadminfile_CreateAllRelations"
			GenerateOnce="false"
		ModuleName="$lower SchemaName$"
		SourceBundle="dbcreate"
		BasePackageName="$lower SchemaName$-$VUnderVersion$/jdbcsp"
		SubPackageName="mysql"
		ExpansionClassName="crrel_$lower SchemaName$"
		ExpansionKeyName="crrel_$lower SchemaName$"
		ExpansionFileName="$dbadminfilename_CreateAllRelations$">#!/bin/bash
#
#	@(#) $GenPackageDir$/$GenFileName$
$MssBashScriptLicense$
$parseMySqlArgs$$validateMySqlArgs$
$iterate SchemaTables( each invoke_CreateTableRelations empty empty )$
</GenFile>

	<GenRule ScopeDef="SchemaDef" GenDef="Table" Name="invoke_CreateTableRelations">echo "$dbadminfilename_CreateTableRelations$" &gt;&gt;$$logfilename
mysql -v -u $$mysqluser --password=$$mysqlpwd &lt; $dbadminfilename_CreateTableRelations$ &gt;&gt;$$logfilename 2&gt;&amp;1
$iterate DispensedId16Generators( first invoke_CreateTableIdgRelations each empty empty empty )$$iterate DispensedId32Generators( first invoke_CreateTableIdgRelations each empty empty empty )$$iterate DispensedId64Generators( first invoke_CreateTableIdgRelations each empty empty empty )$</GenRule>

	<GenRule ScopeDef="Table" GenDef="Id16Gen" Name="invoke_CreateTableIdgRelations">echo "$dbadminfilename_CreateTableIdg16Relations$" &gt;&gt;$$logfilename
mysql -v -u $$mysqluser --password=$$mysqlpwd &lt; $dbadminfilename_CreateTableIdg16Relations$ &gt;&gt;$$logfilename 2&gt;&amp;1
</GenRule>

	<GenRule ScopeDef="Table" GenDef="Id32Gen" Name="invoke_CreateTableIdgRelations">echo "$dbadminfilename_CreateTableIdg32Relations$" &gt;&gt;$$logfilename
mysql -v -u $$mysqluser --password=$$mysqlpwd &lt; $dbadminfilename_CreateTableIdg32Relations$ &gt;&gt;$$logfilename 2&gt;&amp;1
</GenRule>

	<GenRule ScopeDef="Table" GenDef="Id64Gen" Name="invoke_CreateTableIdgRelations">echo "$dbadminfilename_CreateTableIdg64Relations$" &gt;&gt;$$logfilename
mysql -v -u $$mysqluser --password=$$mysqlpwd &lt; $dbadminfilename_CreateTableIdg64Relations$ &gt;&gt;$$logfilename 2&gt;&amp;1
</GenRule>

</RuleSet>
