<RuleSet
	xmlns="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="mysql"
	Name="schema/dbcreate/mysql/crtbl_table_idg16.pgsql"
	Revision="2.13"
	Descr="null">

	<GenFile ScopeDef="Table" GenDef="Id16Gen" Name="dbadminfile_CreateTableIdg16Table"
			GenerateOnce="false"
		ModuleName="$lower SchemaName$"
		SourceBundle="dbcreate"
		BasePackageName="$lower SchemaName$-$VUnderVersion$/jdbcsp"
		SubPackageName="mysql"
		ExpansionClassName="crtbl_$lower DbTableName$_idg16"
		ExpansionKeyName="crtbl_$lower DbTableName$_idg16"
		ExpansionFileName="$dbadminfilename_CreateTableIdg16Table$">--
--	@(#) $GenPackageDir$/$GenFileName$
$MssDoubleDashScriptLicense$
CREATE TABLE $lower DbSchemaName$.$DbTableName$_idg16 ($reference Dispenser reference PrimaryKeyIndex iterate Columns( each clause_CreateColComma )$
	slice_id	SMALLINT$clause_NotNull$,
	next_id	$clause_ColType$$clause_NotNull$ )
	ENGINE=InnoDB$RunSqlStmt$
ALTER TABLE $lower DbSchemaName$.$DbTableName$_idg16
	ADD CONSTRAINT pk_$lower DbTableName$_idg16 PRIMARY KEY ($reference Dispenser reference PrimaryKeyIndex iterate Columns( each clause_PKeyColComma )$ slice_id )$RunSqlStmt$
</GenFile>

	<GenRule ScopeDef="Index" GenDef="IndexCol" Name="clause_CreateColComma">$clause_CreateCol$,</GenRule>

	<GenRule ScopeDef="Index" GenDef="IndexCol" Name="clause_CreateCol">
	$lower reference Column DbColumnName$	$reference Column clause_ColType$$reference Column switch IsNullable yes clause_Null default clause_NotNull$$reference Column optclause_RangeConstraint$</GenRule>

</RuleSet>
