<RuleSet
	xmlns="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="oracle"
	Name="schema/dbcreate/oracle/crrel_table_idg32.plsql"
	Revision="2.13"
	Descr="Oracle Create Table Id32 Generator Relationships PL/SQL Script">

	<GenFile ScopeDef="Table" GenDef="Id32Gen" Name="dbadminfile_CreateTableIdg32Relations"
			GenerateOnce="false"
		ModuleName="$lower SchemaName$"
		SourceBundle="dbcreate"
		BasePackageName="$lower SchemaName$-$VUnderVersion$/jdbcsp"
		SubPackageName="oracle"
		ExpansionClassName="crrel_$lower DbTableName$_idg32"
		ExpansionKeyName="crrel_$lower DbTableName$_idg32"
		ExpansionFileName="$dbadminfilename_CreateTableIdg32Relations$">--
--	@(#) $GenPackageDir$/$GenFileName$
$MssDoubleDashScriptLicense$
ALTER TABLE $lower DbSchemaName$.$DbTableName$_idg32 ADD CONSTRAINT $DbTableName$_idg32_prnt
	FOREIGN KEY ($reference Dispenser reference PrimaryKeyIndex iterate Columns( each clause_PKeyColComma last clause_PKeyCol )$
	) REFERENCES $lower DbSchemaName$.$reference Dispenser DbTableName$ ($reference Dispenser reference PrimaryKeyIndex iterate Columns( each clause_PKeyColComma last clause_PKeyCol )$ )
	ON DELETE CASCADE$RunSqlStmt$
</GenFile>

</RuleSet>
