<RuleSet
	xmlns="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="db2luw"
	Name="schema/dbcreate/db2luw/crtbl_schema_idg32.sql"
	Revision="2.13"
	Descr="IBM DB/2 LUW create schema Id32 generator sql script">

	<GenFile ScopeDef="SchemaDef" GenDef="Id32Gen" Name="dbadminfile_CreateSchemaIdg32Table"
			GenerateOnce="false"
		ModuleName="$lower SchemaName$"
		SourceBundle="dbcreate"
		BasePackageName="$lower SchemaName$-$VUnderVersion$/jdbcsp"
		SubPackageName="db2luw"
		ExpansionClassName="crtbl_$lower DbSchemaName$_idg32"
		ExpansionKeyName="crtbl_$lower DbSchemaName$_idg32"
		ExpansionFileName="$dbadminfilename_CreateSchemaIdg32Table$">--
--	@(#) $GenPackageDir$/$GenFileName$
$MssDoubleDashScriptLicense$
CREATE TABLE $lower DbSchemaName$.$DbSchemaName$_idg32 ($ContSqlStmt$	slice_id	SMALLINT$clause_NotNull$,$ContSqlStmt$	next_id	$clause_ColType$$clause_NotNull$ )$ContSqlStmt$IN msidata1$RunSqlStmt$
ALTER TABLE $lower DbSchemaName$.$DbSchemaName$_idg32$ContSqlStmt$	ADD CONSTRAINT pk_$lower DbSchemaName$_idg32 PRIMARY KEY ($ContSqlStmt$		slice_id )$RunSqlStmt$
</GenFile>

</RuleSet>
