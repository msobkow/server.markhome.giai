	<GenFile ScopeDef="SchemaDef" GenDef="Id16Gen" Name="dbadminfile_CreateSFNextSchemaIdGen"
			GenerateOnce="false"
		ModuleName="$lower SchemaName$"
		SourceBundle="dbcreate"
		BasePackageName="$lower SchemaName$-$VUnderVersion$/jdbcsp"
		SubPackageName="db2luw"
		ExpansionClassName="$dbadminfilename_CreateSFNextSchemaIdGen$"
		ExpansionKeyName="$dbadminfilename_CreateSFNextSchemaIdGen$"
		ExpansionFileName="$dbadminfilename_CreateSFNextSchemaIdGen$" >--
--	@(#) $GenPackageDir$/$GenFileName$
$MssDoubleDashScriptLicense$
create or replace procedure $sf_next_schemaidgen$()	\\
dynamic result sets 1	\\
modifies sql data	\\
language sql	\\
begin	\\
	declare NextId smallint;	\\
	declare retcurs cursor with return to client for	\\
		select NextId from sysibm.sysdummy1;	\\
	begin	\\
		call $sp_next_schemaidgen$( NextId );	\\
		open retcurs;	\\
	end;	\\
end
</GenFile>

