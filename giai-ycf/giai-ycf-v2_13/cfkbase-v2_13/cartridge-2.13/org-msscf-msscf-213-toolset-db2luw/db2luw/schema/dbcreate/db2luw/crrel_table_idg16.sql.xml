<RuleSet
	xmlns="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd https://msobkow.github.io/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="db2luw"
	Name="schema/dbcreate/db2luw/crrel_table_idg16.sql"
	Revision="2.13"
	Descr="IBM DB/2 LUW create table Id16 generator sql script">

	<GenFile ScopeDef="Table" GenDef="Id16Gen" Name="dbadminfile_CreateTableIdg16Relations"
			GenerateOnce="false"
		ModuleName="$lower SchemaName$"
		SourceBundle="dbcreate"
		BasePackageName="$lower SchemaName$-$VUnderVersion$/jdbcsp"
		SubPackageName="db2luw"
		ExpansionClassName="crrel_$lower DbTableName$_idg16"
		ExpansionKeyName="crrel_$lower DbTableName$_idg16"
		ExpansionFileName="$dbadminfilename_CreateTableIdg16Relations$">--
--	@(#) $GenPackageDir$/$GenFileName$
$MssDoubleDashScriptLicense$
ALTER TABLE $lower DbSchemaName$.$DbTableName$_idg16 ADD CONSTRAINT $DbTableName$_idg16_prnt$ContSqlStmt$	FOREIGN KEY ($reference Dispenser reference PrimaryKeyIndex iterate Columns( each clause_PKeyColComma last clause_PKeyCol )$$ContSqlStmt$	) REFERENCES $lower DbSchemaName$.$reference Dispenser DbTableName$ ($reference Dispenser reference PrimaryKeyIndex iterate Columns( each clause_PKeyColComma last clause_PKeyCol )$ )
	ON DELETE CASCADE$RunSqlStmt$
</GenFile>

</RuleSet>
